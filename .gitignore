# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template itself, which is meant to be committed and is what README.md's
# setup instructions ("copy .env.example to .env") depend on existing in a fresh clone —
# confirmed live this was never actually tracked despite the blanket .env* rule above,
# meaning every edit to it was silently local-only until now.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# client folders (uploaded assets, crawl data, generated sites, exports)
/storage
# local sqlite database
/dev.db
/dev.db-journal

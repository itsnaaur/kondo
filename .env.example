# Pooled (pgbouncer, transaction mode) connection — used by the app's runtime
# PrismaClient (lib/prisma.ts), both the Vercel app and the worker (scripts/worker.ts).
DATABASE_URL="postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session-mode pooler connection (port 5432, same pooler host as DATABASE_URL above) —
# used only by the Prisma CLI for migrations (prisma.config.ts), never by the app at
# runtime. Deliberately NOT Supabase's literal "Direct connection" (db.<ref>.supabase.co)
# — confirmed live that host is IPv6-only unless you pay for Supabase's IPv4 add-on, and
# is simply unreachable ("P1001: Can't reach database server") from GitHub Actions'
# migrate-deploy job, and from plenty of IPv4-only local networks too. The session
# pooler is IPv4-reachable and still session-mode (not transaction-mode, which Prisma's
# migration engine can't use) — get it from Supabase's Connect modal: connection type
# "Session pooler", format "URI".
DIRECT_URL="postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Required by the Vercel app AND the worker — the worker uploads crawled images to
# Supabase Storage directly (lib/storage/upload-asset.ts) and fails analysis without it.
SUPABASE_SECRET_KEY=""

ANTHROPIC_API_KEY=""

# Rate limiting and the daily spend ceiling (lib/security/rate-limit.ts). Without these,
# the app still runs, but every limiter fails open with a console.warn — no protection
# against a runaway loop or one user flooding the queue. Get these from
# console.upstash.com after creating a Redis database (the free tier is enough to start).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Error tracking (Sentry). Fully optional — every Sentry.init() call in this app (main
# app: sentry.server.config.ts/sentry.edge.config.ts/instrumentation-client.ts; worker:
# scripts/worker.ts) no-ops safely with these unset, same as the Upstash pair above.
# Create a free project at sentry.io to get a DSN.
SENTRY_DSN=""
# Same DSN, just under the NEXT_PUBLIC_ prefix Next.js requires for anything read in the
# browser bundle (instrumentation-client.ts) — the main app's client-side error reporting
# specifically, not the worker (which is server-only and reads SENTRY_DSN above).
NEXT_PUBLIC_SENTRY_DSN=""
# Only needed if you want next.config.ts's withSentryConfig to upload source maps on
# build (readable stack traces in Sentry instead of minified ones) — not required for
# error reporting itself to work. Get a token from Sentry → Settings → Auth Tokens.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

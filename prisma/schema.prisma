// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Purely a progress indicator for the Analyse Site job — never a gate on Choose
// Template/Generate & Preview/Concept History. Those are gated on data
// (contentRecord.reviewedAt != null / concepts.length > 0), not on this enum, so a
// transient re-analysis failure can never lock a client out of its own already-approved
// content or its concept history. See lib/actions/analysis.ts and the Client Workspace page.
enum ClientStatus {
  NEW              // created, no analysis run yet
  ANALYZING        // crawl + one AI structuring call in flight (first run or re-analysis)
  ANALYSIS_FAILED  // job errored — Analyse/Re-analyse Site can be retried
  READY_FOR_REVIEW // ContentRecord written (or re-written), awaiting human review/re-review
}

enum AssetType {
  LOGO
  IMAGE
}

// Mirrors auth.users (managed by Supabase Auth) via a DB trigger — Prisma can't
// relate directly across schemas, so we keep our own copy in `public` to join against.
model Profile {
  id        String   @id
  email     String?
  createdAt DateTime @default(now())

  clients               Client[]
  reviewedContentRecords ContentRecord[]
  concepts              Concept[]
}

model Client {
  id              String       @id @default(cuid())
  name            String
  siteUrl         String
  status          ClientStatus @default(NEW)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  createdByUserId String?
  createdBy       Profile?     @relation(fields: [createdByUserId], references: [id])
  deletedAt       DateTime?

  // Drives the ANALYZING progress UI (see app/api/clients/[id]/status/route.ts). Not a
  // gate on anything — see the ClientStatus comment above.
  crawlPagesDone  Int?
  crawlPagesTotal Int?

  assets        Asset[]
  pages         CrawledPage[]
  contentRecord ContentRecord?
  concepts      Concept[]
}

model Asset {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type      AssetType @default(IMAGE)
  filename  String
  // Public Supabase Storage URL, not a local filesystem path — crawled assets are
  // uploaded via lib/storage/upload-asset.ts so they're readable by both the worker
  // process and the Vercel app (different hosts, no shared disk). Assets are
  // append-only: a re-analysis or a manual fix creates new rows and re-points
  // ContentRecord at them rather than deleting the old ones, since already-published
  // Concept HTML has this URL baked in permanently. Only a permanent client deletion
  // (trash purge) ever removes the underlying Storage object.
  url       String
  mimeType  String
  size      Int
  createdAt DateTime  @default(now())

  // SHA-256 of the downloaded bytes, set only for crawler-sourced assets (never for a
  // manually-uploaded replacement — see lib/actions/content.ts's replaceContentImage,
  // which has no reason to dedupe a human's deliberate upload against anything). Lets
  // downloadCrawlImages (lib/crawl/download-images.ts) recognize "this exact photo was
  // already downloaded and uploaded for this client in an earlier analysis" and reuse the
  // existing Asset instead of re-downloading, re-uploading to Storage, and creating a new
  // row for byte-identical content every time someone re-analyses an otherwise-unchanged
  // site. Nullable so existing rows (created before this column existed) simply never
  // match — dedup only ever applies going forward, no backfill needed.
  contentHash String?

  contentRecordLogoFor ContentRecord? @relation("ContentRecordLogo")

  @@index([clientId, contentHash])
}

model CrawledPage {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  url         String
  title       String?
  textContent String?
  createdAt   DateTime @default(now())
}

// The structured, human-reviewable content record produced by Analyse Site — business
// identity, services, testimonials, contact details, brand colors, and images, plus
// per-field confidence/flag metadata (see lib/content/types.ts for the JSON shapes) that
// the Review Extraction screen renders as ConfidenceBadges. One per client.
//
// reviewedAt is the real "is this client ready for Choose Template / Generate & Preview"
// gate — not Client.status. It's set only by an explicit human approval
// (approveContentRecord) and cleared to null on every fresh write from Analyse Site
// (including a re-analysis), so stale or newly-overwritten-but-unreviewed content is
// never mistaken for approved content.
model ContentRecord {
  id       String @id @default(cuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  businessName String?
  tagline      String?
  aboutCopy    String? // AI-rewritten, punchier version — the only version stored
  ctaLabel     String? // the site's own recurring CTA phrase, e.g. "Book an appointment" —
                        // null when nothing recurs clearly enough to trust as their actual wording

  services     Json // ContentService[]
  testimonials Json // ContentTestimonial[]
  brandColors  Json // ContentColor[]
  images       Json // ContentImage[] (references Asset ids)

  // Extraction expansion — the trust-band/proof content templates need beyond services
  // and testimonials. @default("[]") both backfills existing rows at migration time and
  // means an empty array (a normal, common outcome — see structure-and-rewrite.ts) is
  // never a missing-data state to special-case.
  stats           Json @default("[]") // ContentStat[]
  faqs            Json @default("[]") // ContentFaq[]
  differentiators Json @default("[]") // ContentDifferentiator[]
  process         Json @default("[]") // ContentProcessStep[]

  // Second extraction expansion — fields that don't reliably appear at all rather than
  // just being thin (see structure-and-rewrite.ts's system prompt for what each one is and
  // isn't allowed to infer). Same @default("[]") reasoning as above.
  serviceAreas Json @default("[]") // ContentServiceArea[]
  hours        Json @default("[]") // ContentHours[]
  offers       Json @default("[]") // ContentOffer[]
  credentials  Json @default("[]") // ContentCredential[]

  contactEmail   String?
  contactPhone   String?
  contactAddress String?

  logoAssetId String? @unique
  logoAsset   Asset?  @relation("ContentRecordLogo", fields: [logoAssetId], references: [id], onDelete: SetNull)

  detectedIndustry String? // drives template pre-selection, see lib/templates/registry.ts

  // Confidence/flag metadata for the scalar fields above, keyed by field name
  // (Record<string, { confidence: "low"|"medium"|"high"; reason: string }>). Array-item
  // fields (services/testimonials/brandColors/images) carry their own confidence/flagged
  // inline instead — see lib/content/types.ts.
  fieldFlags Json?

  crawlPagesCount      Int     @default(0)
  sourceCrawlTruncated Boolean @default(false)
  // Set when the structuring call returned almost nothing outside services — testimonials,
  // stats, faqs, differentiators, process, serviceAreas, hours, offers, credentials all (or
  // nearly all) empty — despite a substantial amount of selected source text. Confirmed live
  // this pattern can mean a completed, "successful" (schema-valid, non-truncated) tool call
  // that the model nonetheless emptied out for reasons validateShape/coerceTextArray can't
  // detect, since an empty array is *usually* the correct answer for these fields (see
  // structure-and-rewrite.ts). This flag exists because that failure mode is otherwise
  // indistinguishable from a genuinely thin site: status still goes to READY_FOR_REVIEW,
  // pagesAnalyzed still looks healthy. Always recomputed fresh on every analysis (including
  // re-analysis), same as sourceCrawlTruncated — a later successful run clears it.
  possibleExtractionCollapse Boolean @default(false)
  // Set when every vision-eligible image (at least 4 sent to classification) came back
  // subject: "abstract" — confirmed live this can happen on a single analysis run even when
  // the client has genuinely usable photography: three independent runs against the same
  // Propell Property images produced "all excluded" once and "6 of 7 real" twice, so a
  // single bad roll is indistinguishable from a client that actually has nothing usable
  // unless something flags it. Same shape as possibleExtractionCollapse — doesn't hard-fail
  // or retry, just stops a bad roll from looking like a legitimate "no photos" result.
  // Recomputed fresh on every analysis; a later successful run clears it.
  possibleImageMisclassification Boolean @default(false)
  // How many of crawlPagesCount were actually fed to the structuring/rewrite call (see
  // lib/content/select-relevant-pages.ts) — the two numbers routinely differ a lot on
  // anything bigger than a handful of pages (confirmed live: 92 crawled, 12 read), and
  // crawlPagesCount alone makes an incomplete extraction look complete. The review
  // screen surfaces a warning whenever pagesAnalyzed < crawlPagesCount.
  pagesAnalyzed Int @default(0)

  reviewedAt       DateTime?
  reviewedByUserId String?
  reviewedBy       Profile?  @relation(fields: [reviewedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  concepts Concept[]
}

// A generated landing-page concept: one hand-built template filled with a snapshot of the
// (approved, at generation time) content record. Only created when a human clicks
// "Generate Concept" — trying templates in the gallery or toggling desktop/mobile is a
// pure, ephemeral render, nothing persisted. `html` is the fully rendered page (inlined
// CSS, absolute Supabase Storage image URLs — "portable," not fully self-contained, see
// lib/templates/shell.tsx) stored directly in Postgres rather than on disk, since
// "Generate Concept" runs as a fast Vercel server action and Vercel's filesystem is
// ephemeral — a file written there would not reliably survive to be read back by the
// publish route later.
//
// publishSlug is unique per Concept, not per Client: each generated concept gets its own
// permanent link once published, so a follow-up concept (different template, or a re-run
// after editing content) is a new row with its own new slug rather than overwriting
// whatever link was already sent to a prospect.
model Concept {
  id              String        @id @default(cuid())
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contentRecordId String
  contentRecord   ContentRecord @relation(fields: [contentRecordId], references: [id], onDelete: Cascade)

  templateKey String // matches lib/templates/<key>
  html        String

  publishSlug   String?   @unique
  publishStatus String    @default("DRAFT") // DRAFT | PUBLISHED | UNPUBLISHED
  publishedAt   DateTime?

  createdByUserId String?
  createdBy       Profile? @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  @@index([clientId, createdAt])
}

// The background-job queue. Vercel serverless functions are killed once the response is
// sent, so a multi-page Playwright crawl can't run as a fire-and-forget async call from a
// server action — it has to be a durable row a separate long-running worker process
// (scripts/worker.ts) picks up. Only one job type exists: analysing a site is the one
// slow, AI-touching step in the flow; everything downstream (template rendering, publish)
// is synchronous.
model Job {
  id              String    @id @default(cuid())
  type            String // ANALYZE_SITE
  payload         Json
  status          String    @default("PENDING") // PENDING | RUNNING | COMPLETE | FAILED
  attempts        Int       @default(0)
  lastError       String?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  startedAt       DateTime?
  finishedAt      DateTime?

  @@index([status, createdAt])
  @@index([createdByUserId, status])
}

// Who did what, when — login, client created/trashed/deleted, analysis started/failed,
// content edited/approved, concept generated/published/unpublished, export downloaded.
// Deliberately stores only IDs and short event metadata, never prompt text, generated
// content, or crawled content — logs are the least-protected place data lives.
model AuditLog {
  id        String   @id @default(cuid())
  event     String // LOGIN | CLIENT_CREATED | CLIENT_TRASHED | CLIENT_DELETED |
                    // ANALYSIS_STARTED | ANALYSIS_FAILED | CONTENT_UPDATED |
                    // CONTENT_APPROVED | CONCEPT_GENERATED | CONCEPT_PUBLISHED |
                    // CONCEPT_UNPUBLISHED | EXPORT_DOWNLOADED
  userId    String?
  clientId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([userId, createdAt])
}
